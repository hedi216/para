generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum StockMovementType {
  INITIAL
  ADJUSTMENT
  WEB_ORDER
  POS_SALE
  RETURN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  IN_STORE
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Store {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  address        String?
  city           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cashRegisters  CashRegister[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  orders         Order[]
  posSales       PosSale[]
}

model CashRegister {
  id        String    @id @default(cuid())
  code      String
  label     String
  storeId   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id])
  posSales  PosSale[]

  @@unique([storeId, code])
  @@index([storeId])
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  role             UserRole
  firstName        String
  lastName         String
  phone            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  customerProfile  CustomerProfile?
  employeeProfile  EmployeeProfile?
  customerOrders   Order[]          @relation("CustomerOrders")
  posSales         PosSale[]        @relation("PosEmployee")
  createdMovements StockMovement[]  @relation("StockMovementActor")
}

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  loyaltyPoints  Int       @default(0)
  birthDate      DateTime?
  defaultAddress String?
  city           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  posSales       PosSale[]
}

model EmployeeProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeNo String   @unique
  jobTitle   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id
  slug      String    @unique
  name      String
  label     String?
  imageUrl  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id
  slug      String    @unique
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String?
  sku            String?         @unique
  barcode        String?         @unique
  price          Decimal         @db.Decimal(10, 3)
  oldPrice       Decimal?        @db.Decimal(10, 3)
  badge          String?
  imageUrl       String?
  isActive       Boolean         @default(true)
  categoryId     String
  brandId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category        @relation(fields: [categoryId], references: [id])
  brand          Brand           @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  posSaleItems   PosSaleItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model InventoryItem {
  id           String          @id @default(cuid())
  productId    String
  storeId      String
  quantity     Int             @default(0)
  reserved     Int             @default(0)
  reorderLevel Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store           @relation(fields: [storeId], references: [id])
  movements    StockMovement[]

  @@unique([productId, storeId])
  @@index([storeId])
}

model StockMovement {
  id             String            @id @default(cuid())
  inventoryId    String
  productId      String
  storeId        String
  type           StockMovementType
  quantity       Int
  beforeQuantity Int
  afterQuantity  Int
  reason         String?
  reference      String?
  orderId        String?
  posSaleId      String?
  createdById    String?
  createdAt      DateTime          @default(now())
  inventory      InventoryItem     @relation(fields: [inventoryId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  store          Store             @relation(fields: [storeId], references: [id])
  order          Order?            @relation(fields: [orderId], references: [id])
  posSale        PosSale?          @relation(fields: [posSaleId], references: [id])
  createdBy      User?             @relation("StockMovementActor", fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([posSaleId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  idempotencyKey  String?
  customerId      String
  storeId         String?
  status          OrderStatus     @default(CONFIRMED)
  subtotal        Decimal         @db.Decimal(10, 3)
  deliveryFee     Decimal         @default(0) @db.Decimal(10, 3)
  total           Decimal         @db.Decimal(10, 3)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus   @default(PENDING)
  recipientName   String
  recipientPhone  String
  deliveryAddress String?
  deliveryCity    String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        User            @relation("CustomerOrders", fields: [customerId], references: [id])
  store           Store?          @relation(fields: [storeId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  stockMovements  StockMovement[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  brandName   String
  unitPrice   Decimal @db.Decimal(10, 3)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 3)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String?
  posSaleId String?
  method    PaymentMethod
  status    PaymentStatus
  amount    Decimal       @db.Decimal(10, 3)
  reference String?
  createdAt DateTime      @default(now())
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  posSale   PosSale?      @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([posSaleId])
}

model PosSale {
  id             String           @id @default(cuid())
  receiptNumber  String           @unique
  idempotencyKey String?
  employeeId     String
  customerId     String?
  storeId        String
  registerId     String
  status         SaleStatus       @default(COMPLETED)
  subtotal       Decimal          @db.Decimal(10, 3)
  total          Decimal          @db.Decimal(10, 3)
  paymentMethod  PaymentMethod
  createdAt      DateTime         @default(now())
  refundedAt     DateTime?
  employee       User             @relation("PosEmployee", fields: [employeeId], references: [id])
  customer       CustomerProfile? @relation(fields: [customerId], references: [id])
  store          Store            @relation(fields: [storeId], references: [id])
  register       CashRegister     @relation(fields: [registerId], references: [id])
  items          PosSaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@unique([registerId, idempotencyKey])
  @@index([employeeId, createdAt])
  @@index([storeId, createdAt])
  @@index([registerId, createdAt])
}

model PosSaleItem {
  id          String  @id @default(cuid())
  posSaleId   String
  productId   String
  productName String
  brandName   String
  unitPrice   Decimal @db.Decimal(10, 3)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 3)
  posSale     PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([posSaleId])
}
